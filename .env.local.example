# Copy this file to .env.local (already gitignored) to enable
# `npm run fetch:sermons` / `npm run build` to pull real YouTube data.
# See functions/README.md for how to get these values.

YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
# JSON array of { "id": "<playlist id>", "label": "<display name>" }
YOUTUBE_PLAYLISTS_JSON=[{"id":"PLxxxxxxxxxxxxxxxxxxxxxxxxx","label":"Serie Efesios"},{"id":"PLyyyyyyyyyyyyyyyyyyyyyyyyy","label":"Prédicas 2026"}]

# Only needed once the Azure Function is deployed, to point the frontend at
# it instead of the local/relative default. Prefix with VITE_ so Vite
# exposes it to the browser build.
VITE_SERMONS_API_URL=
VITE_CONTACT_API_URL=
